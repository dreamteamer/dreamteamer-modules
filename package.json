{
	"name": "dreamteamer-modules",
	"private": true,
	"description": "The official dreamteamer modules — one npm package per module, released independently from this one repo",
	"license": "Apache-2.0",
	"type": "module",
	"workspaces": [
		"modules/*"
	],
	"scripts": {
		"test": "node scripts/test.ts",
		"typecheck": "tsc -p tsconfig.json",
		"typecheck:test": "tsc -p tests/tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.20.5",
		"dreamteamer": "^0.49.0",
		"dreamteamer-0-48": "npm:dreamteamer@0.48.1",
		"js-yaml": "^4.1.0",
		"prettier": "^3.10.1",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=20"
	},
	"dreamteamer": {
		"harnesses": [],
		"gitignore_runtime_folder": true
	},
	"allowScripts": {
		"vue-demi@0.14.10": true,
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true
	}
}
