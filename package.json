{
	"name": "dreamteamer-modules",
	"private": true,
	"description": "The official dreamteamer modules — one npm package per module, released independently from this one repo",
	"license": "Apache-2.0",
	"type": "module",
	"workspaces": [
		"modules/*"
	],
	"scripts": {
		"build": "node scripts/build.ts",
		"test": "node scripts/test.ts",
		"release:next": "node scripts/release-next.ts",
		"typecheck": "tsc -p tsconfig.json",
		"typecheck:test": "tsc -p tests/tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"ui": "node playground/dev.ts",
		"ui-legacy": "node playground/dev.ts --app=ui-legacy"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.20.5",
		"dreamteamer": "^0.50.0",
		"dreamteamer-0-48": "npm:dreamteamer@0.48.1",
		"js-yaml": "^4.1.0",
		"prettier": "^3.10.1",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.18"
	},
	"dreamteamer": {
		"harnesses": [],
		"gitignore_runtime_folder": true
	},
	"allowScripts": {
		"vue-demi@0.14.10": true,
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true
	}
}
