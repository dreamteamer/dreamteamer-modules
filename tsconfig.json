{
	// Type-checks this repo's Node code without emitting: `npm run typecheck`. Every module's bin/, lib/,
	// src/ and skills/, and the root scripts/, with implicit any allowed for now. The suites (tests/ and modules/*/test/) are checked by
	// tests/tsconfig.json, `npm run typecheck:test`, and never gate this one.
	//
	// Settings are the engine's (dreamteamer's own tsconfig.json): a checkout RUNS these .ts files through
	// Node's type stripping, so only erasable syntax is allowed and a relative import names the .ts file.
	//
	// Not here: the ui module's Vue app (modules/ui/src), which is bundled and checked by
	// `vue-tsc -p modules/ui/src/tsconfig.json` with bundler resolution; the rnd prototype's browser files,
	// which are served to a browser as-is.
	"compilerOptions": {
		"target": "es2023",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["es2023"],
		"types": ["node"],
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"resolveJsonModule": true,
		"strict": false,
		"noImplicitAny": false,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["modules/**/*.ts", "scripts/**/*.ts"],
	"exclude": [
		"**/node_modules/**",
		"**/fixtures/**",
		"**/*.d.ts",
		"modules/*/test/**",
		"modules/ui/src/**",
		"modules/ui/dist/**"
	]
}
