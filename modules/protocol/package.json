{
	"name": "@dreamteamer/protocol",
	"version": "0.3.1",
	"description": "The host protocol a dreamteamer UI speaks: the written contract, its route table, and a contract suite any host runs",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dreamteamer/dreamteamer-modules.git",
		"directory": "modules/protocol"
	},
	"keywords": [
		"dreamteamer",
		"dreamteamer-module"
	],
	"exports": {
		".": "./dist/src/routes.js",
		"./routes": "./dist/src/routes.js",
		"./contract": "./dist/lib/contract/run.js",
		"./contract/fixture": "./dist/lib/contract/fixture.js",
		"./package.json": "./package.json",
		"./handler": "./dist/src/createHandler.js",
		"./host/*": "./dist/src/host/*.js",
		"./nav-model": "./dist/src/navModel.js",
		"./nav-doc": "./dist/src/navDoc.js",
		"./gate": "./dist/src/gate.js",
		"./pane-scope": "./dist/src/paneScope.js",
		"./pane": "./dist/src/pane.js",
		"./reshape": "./dist/src/reshape.js",
		"./apply-write": "./dist/src/applyWrite.js",
		"./frame-bridge": "./dist/src/createFrameBridge.js",
		"./module-scope": "./dist/src/buildModuleScope.js",
		"./module-grant": "./dist/src/readModuleGrant.js",
		"./frame-document": "./dist/src/buildFrameDocument.js"
	},
	"bin": {
		"dt-nav": "bin/dt-nav.mjs"
	},
	"files": [
		"README.md",
		"PROTOCOL.md",
		"bin",
		"dist",
		"!bin/**/*.ts"
	],
	"dreamteamer": {
		"title": "Protocol",
		"description": "The host protocol the dreamteamer UI speaks to whatever hosts it — the VS Code extension in-process, dt serve and dt web over HTTP: every route with its shapes and errors, the notifications, boot globals and host capabilities in PROTOCOL.md, a contract suite every host runs, and the shared handler that answers it. A library: no collection, no verb.",
		"engine": ">=0.43.0"
	},
	"dependencies": {
		"js-yaml": "^4.1.0"
	},
	"scripts": {
		"prepack": "node ../../scripts/build.ts --module=protocol"
	}
}
