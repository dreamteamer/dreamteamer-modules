{
	"$comment": "core 0.11.0 compiled (engine 0.48.0): storage and ids of the five collections core authored, frozen before they moved to their own packages (cr-dt-008 task 1)",
	"sessions": {
		"storage": {
			"path": "data/sessions",
			"format": "md"
		},
		"ids": {
			"from": "{{ started | date:YYYY/MM }}/{{ started | date }}--{{ name | slug }}",
			"pattern": "^(\\d{4}/\\d{2}/\\d{4}-\\d{2}-\\d{2}--[a-z0-9-]+|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
		}
	},
	"metrics": {
		"storage": {
			"path": "data/metrics",
			"format": "md"
		},
		"ids": {
			"from": [
				"{{ scope | basename }}--{{ name | slug }}",
				"{{ name | slug }}"
			],
			"pattern": "^[a-z0-9][a-z0-9-]*$"
		}
	},
	"roles": {
		"storage": {
			"path": "data/roles",
			"format": "md",
			"suffix": "role"
		},
		"ids": {
			"from": "{{ name | slug }}",
			"pattern": "^[a-z0-9][a-z0-9-]*$"
		}
	},
	"responsibilities": {
		"storage": {
			"path": "data/responsibilities",
			"format": "md",
			"suffix": "responsibility"
		},
		"ids": {
			"from": "{{ name | slug }}",
			"pattern": "^[a-z0-9][a-z0-9-]*$"
		}
	},
	"artifacts": {
		"storage": {
			"path": "data/artifacts",
			"format": "md",
			"shape": "folder",
			"entry": "index.md"
		},
		"ids": {
			"from": "{{ name | slug }}",
			"pattern": "^[a-z0-9][a-z0-9-]*$"
		}
	}
}
